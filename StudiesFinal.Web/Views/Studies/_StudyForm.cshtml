@model StudyInputVM

@{
    var isEdit = Model.Id > 0;
    var canSendToSign = !isEdit || ViewBag.CanSendToSign == true;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label" for="patientSearch">Patient</label>
                            <div class="sf-picker" data-patient-picker="PatientId" data-search-url="@Url.Action("Search", "Patients")">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                                    <input type="search" id="patientSearch" class="form-control" autocomplete="off"
                                           placeholder="Search by name, last name, patient # or date of birth (MM/DD/YYYY)…" value="@Model.PatientLabel" />
                                    <a class="btn btn-outline-secondary" asp-controller="Patients" asp-action="Create" asp-route-returnToStudy="1" title="New patient">
                                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                                    </a>
                                </div>
                                <div class="sf-results" hidden></div>
                            </div>
                            <input type="hidden" asp-for="PatientId" />
                            <input type="hidden" asp-for="PatientLabel" />
                            <span asp-validation-for="PatientId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-5">
                            <label asp-for="StudyDate" class="form-label"></label>
                            <input asp-for="StudyDate" type="date" class="form-control" />
                            <span asp-validation-for="StudyDate" class="text-danger small"></span>
                        </div>

                        @if (Model.Templates != null)
                        {
                            <div class="col-12 col-md-7">
                                <label asp-for="TemplateId" class="form-label"></label>
                                <select asp-for="TemplateId" asp-items="Model.Templates" class="form-select"
                                        data-template-select data-template-target="Information"
                                        data-template-url="@Url.Action("TemplateContent", "StudyTemplates")">
                                    <option value="">Choose a template…</option>
                                </select>
                            </div>
                        }

                        @* Crear: Plantilla | Estudio. Editar (sin plantilla): Estudio bajo Paciente, mismo ancho. *@
                        <div class="col-12 @(Model.Templates != null ? "col-md-5" : "col-md-7")">
                            <label asp-for="StudyName" class="form-label"></label>
                            <input asp-for="StudyName" class="form-control" />
                            <span asp-validation-for="StudyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <label class="form-label">Report</label>
                    <input type="hidden" asp-for="Information" />
                    <partial name="_RichEditor" model="@("Information")" />
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            @if (Model.SavedFiles.Any())
            {
                @* PDF del equipo para consultarlo mientras se llena el informe *@
                <div class="card shadow-sm mb-3 sf-study-files">
                    <div class="card-body">
                        <h3 class="h6 mb-2"><i class="bi bi-file-earmark-medical me-1" aria-hidden="true"></i>Study files</h3>
                        <div class="d-grid gap-3">
                            @foreach (var file in Model.SavedFiles)
                            {
                                <partial name="_StudyFileLink" model="file" />
                            }
                        </div>
                    </div>
                </div>
            }

            @*
                Archivos del estudio: se eligen con el explorador del servidor y solo se guarda la
                ruta (no se sube nada). Por seguridad solo se muestra el nombre del archivo.
            *@
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="h6 mb-1">Files</h3>
                    <p class="small text-muted mb-3">Choose the study files from the studies server. They are not copied: the study only keeps a link to them.</p>

                    @for (var slot = 1; slot <= 3; slot++)
                    {
                        var selectionName = $"FileSelection{slot}";
                        var fileName = Model.FileName(slot);
                        // Archivo nuevo (aún sin guardar): se abre por su ruta relativa; guardado: por el estudio
                        var openUrl = fileName == null ? null
                            : Model.HasNewSelection(slot) ? Url.Action("Open", "Files", new { p = Model.FileSelection(slot) })
                            : isEdit ? Url.Action("OpenFile", "Studies", new { id = Model.Id, slot }) : null;

                        <div class="sf-slot mb-3" data-file-slot="@slot">
                            <label class="form-label small fw-semibold mb-1">File @slot</label>
                            <input type="hidden" name="@selectionName" value="@Model.FileSelection(slot)" data-slot-selection />

                            <div class="sf-slot-file @(fileName == null ? "is-empty" : "")">
                                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                <span class="small text-break" data-slot-name>@(fileName ?? "No file")</span>
                            </div>

                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-slot-browse>
                                    <i class="bi bi-folder2-open me-1" aria-hidden="true"></i>Browse…
                                </button>
                                <a class="btn btn-sm btn-outline-secondary @(openUrl == null ? "d-none" : "")" href="@(openUrl ?? "#")"
                                   target="_blank" rel="noopener" data-open-beside data-slot-open title="Open beside the form">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>Open
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger @(fileName == null ? "d-none" : "")" data-slot-remove title="Remove this file from the study">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Remove</span>
                                </button>
                            </div>
                            <span class="text-danger small">@Html.ValidationMessage(selectionName)</span>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="Processed" class="form-check-input" role="switch" />
                        <label asp-for="Processed" class="form-check-label"></label>
                    </div>
                    <div class="small text-muted mt-2">
                        Phase: @Html.StatusPill(Model.Status)
                        @if (!isEdit)
                        {
                            <div class="mt-1">New studies always start <strong>In progress</strong>.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="sf-sticky-actions d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1" aria-hidden="true"></i>@(isEdit ? "Save changes" : "Create study")
        </button>
        @if (canSendToSign)
        {
            <button type="submit" name="andSendToSign" value="1" class="btn btn-outline-primary">
                <i class="bi bi-send me-1" aria-hidden="true"></i>Save and send to sign
            </button>
        }
        @if (isEdit)
        {
            <a asp-action="Details" asp-route-key="@Model.Id" class="btn btn-secondary">Cancel</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
    </div>
</form>

@* Explorador de la carpeta de estudios del servidor (FilesController.Browse). Solo muestra nombres. *@
<div class="modal fade" id="filePicker" tabindex="-1" aria-labelledby="filePickerTitle" aria-hidden="true"
     data-browse-url="@Url.Action("Browse", "Files")" data-open-url="@Url.Action("Open", "Files")">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filePickerTitle"><i class="bi bi-folder2-open me-2" aria-hidden="true"></i>Choose a file</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="sf-picker-bar">
                    <nav aria-label="Folders" class="sf-picker-crumbs" data-picker-crumbs></nav>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input type="search" class="form-control" placeholder="Search in this folder…" data-picker-search aria-label="Search in this folder" />
                    </div>
                </div>
                <div class="sf-picker-list" data-picker-list role="listbox" aria-label="Folders and files"></div>
                <div class="small text-muted px-3 py-2 border-top" data-picker-status></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
