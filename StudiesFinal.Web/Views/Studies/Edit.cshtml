@model StudyInputVM
@{
    ViewData["Title"] = $"Edit study {Model.Id}";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@@2.0.3/dist/quill.snow.css" />
}

<nav class="crumbs" aria-label="Breadcrumb">

    <h2> <a href="@Url.BackToList(new { status = Model.Status.ToString() })">Studies · @Model.Status.Label()</a> /
    <a href="@Url.ListChild("Details", new { key = Model.Id })">#@Model.Id</a> /
        <span>Edit</span>
    </h2>
</nav>

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
        <div>
            <h2>Edit study</h2>
            <div class="ls-sub">@Model.PatientLabel</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @Html.BackButton(new { status = Model.Status.ToString() })
    </div>
</div>

<partial name="_StudyForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/quill@@2.0.3/dist/quill.js"></script>
    <script src="~/js/studies.js" asp-append-version="true"></script>
}
