@model StudyDisplayVM
@inject StudiesFinal.Web.Services.IRichTextSanitizer Sanitizer

@{
    ViewData["Title"] = $"Study {Model.Id}";

    bool canEdit = ViewBag.CanEdit == true;
    bool canSendToSign = ViewBag.CanSendToSign == true;
    bool canReturn = ViewBag.CanReturn == true;
    bool canSign = ViewBag.CanSign == true;
    bool canUnlock = ViewBag.CanUnlock == true;
    bool canDelete = ViewBag.CanDelete == true;
}

<nav class="crumbs" aria-label="Breadcrumb">
    <h2><a href="@Url.BackToList(new { status = Model.Status.ToString() })">Studies · @Model.Status.Label()</a> /
        <span>#@Model.Id</span>
    </h2>
</nav>

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-file-medical"></i></span>
        <div>
            <h2>@(Model.StudyName ?? "Study")</h2>
            <div class="ls-sub">
                <a class="text-reset" asp-controller="Patients" asp-action="Details" asp-route-key="@Model.PatientId">@Model.PatientName</a>
                · @Model.StudyDate.ToString("MM/dd/yyyy")
            </div>
        </div>
        @Html.StatusPill(Model.Status)
    </div>

    <div class="d-flex flex-wrap gap-2">
        @Html.BackButton(new { status = Model.Status.ToString() })

        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1" aria-hidden="true"></i>Print
        </a>
        <a asp-action="Pdf" asp-route-id="@Model.Id" asp-route-download="true" class="btn btn-outline-secondary" title="Download the report as a PDF file">
            <i class="bi bi-file-earmark-arrow-down me-1" aria-hidden="true"></i>Save as PDF
        </a>

        @if (canEdit)
        {
            <a href="@Url.ListChild("Edit", new { key = Model.Id })" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
            </a>
        }

        @if (canSendToSign)
        {
            <form asp-action="SendToSign" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send me-1" aria-hidden="true"></i>Send to sign
                </button>
            </form>
        }

        @if (canReturn)
        {
            <form asp-action="ReturnToProgress" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-warning">
                    <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Return to technicians
                </button>
            </form>
        }

        @if (canSign)
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#signModal">
                <i class="bi bi-pen me-1" aria-hidden="true"></i>Sign
            </button>
        }

        @if (canUnlock)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#unlockModal">
                <i class="bi bi-unlock me-1" aria-hidden="true"></i>Unlock
            </button>
        }

        @if (canDelete)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete" aria-label="Delete">
                <i class="bi bi-trash3" aria-hidden="true"></i>
            </button>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(Model.Information))
                {
                    <p class="text-muted mb-0">The report is empty.</p>
                }
                else
                {
                    <div class="sf-report">@Sanitizer.Render(Model.Information)</div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        @if (Model.Status == StudyStatus.Completed)
        {
            <div class="sf-signature mb-3">
                <i class="bi bi-patch-check-fill fs-3" aria-hidden="true"></i>
                <div>
                    @* Las firmas importadas de Access no tienen usuario (SignedById vacío) *@
                    <div class="fw-semibold">@(Model.SignedById.HasValue && !string.IsNullOrEmpty(Model.SignedByName) ? $"Signed by {Model.SignedByName}" : "Signed (imported from Access)")</div>
                    <div class="small">@Model.SignedAt?.ToString("MM/dd/yyyy h:mm tt")</div>
                </div>
            </div>
            <div class="sf-locked mb-3"><i class="bi bi-lock" aria-hidden="true"></i>Locked: only the doctor can unlock it for editing.</div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="h6">Signed report (PDF)</h3>
                    @if (!string.IsNullOrEmpty(Model.SignedPdfPath))
                    {
                        <partial name="_StudyFileLink" model="@(new StudyFileLink(Model.Id, 0, Model.SignedPdfPath))" />
                    }
                    else
                    {
                        <p class="small text-muted mb-2">The PDF has not been saved to the server yet.</p>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a asp-action="Pdf" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye me-1" aria-hidden="true"></i>View PDF
                        </a>
                        @if (User.IsInRole(Roles.Doctor) || User.IsInRole(Roles.Admin))
                        {
                            <form asp-action="GeneratePdf" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>@(string.IsNullOrEmpty(Model.SignedPdfPath) ? "Generate PDF" : "Regenerate")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h3 class="h6">Files</h3>
                @if (!Model.Links.Any())
                {
                    <p class="text-muted small mb-0">No linked files.</p>
                }
                <div class="d-grid gap-3">
                    @foreach (var link in Model.Links)
                    {
                        <partial name="_StudyFileLink" model="@(new StudyFileLink(Model.Id, link.Slot, link.Path))" />
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="h6">Details</h3>
                <dl class="row small mb-0">
                    <dt class="col-5">Study #</dt><dd class="col-7">@Model.Id</dd>
                    <dt class="col-5">Patient</dt><dd class="col-7">@Model.PatientName</dd>
                    <dt class="col-5">Age</dt><dd class="col-7">@(Model.PatientAge?.ToString() ?? "—")</dd>
                    <dt class="col-5">Date of birth</dt><dd class="col-7">@(Model.PatientDateOfBirth?.ToString("MM/dd/yyyy") ?? "—")</dd>
                    <dt class="col-5">Processed</dt><dd class="col-7">@(Model.Processed ? "Yes" : "No")</dd>
                    <dt class="col-5">Created</dt><dd class="col-7">@Model.CreatedAt.ToString("MM/dd/yyyy") @(string.IsNullOrEmpty(Model.CreatedByName) ? "" : $"· {Model.CreatedByName}")</dd>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-5">Modified</dt>
                        <dd class="col-7">@Model.UpdatedAt.Value.ToString("MM/dd/yyyy h:mm tt") · @Model.UpdatedByName</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

@if (canSign)
{
    <div class="modal fade" id="signModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Sign study</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    When signed, the study moves to <strong>Completed</strong> and is locked.
                    Only you will be able to unlock it later.
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Sign" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-success">Sign</button>
                    </form>
                    <form asp-action="Sign" asp-route-id="@Model.Id" asp-route-next="true" method="post">
                        <button type="submit" class="btn btn-success">Sign and next</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (canUnlock)
{
    <div class="modal fade" id="unlockModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger">Unlock signed study</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>The signature will be removed and the study will go back to <strong>To sign</strong> so it can be edited. It will need to be signed again.</p>
                    <label for="reason" class="form-label">Reason (saved in the activity log)</label>
                    <textarea id="reason" name="reason" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Unlock</button>
                </div>
            </form>
        </div>
    </div>
}

@if (canDelete)
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger">Delete study</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete study <strong>@Model.Id</strong> of <strong>@Model.PatientName</strong>?
                    <br />An admin can restore it from Deleted items. Files on the server are not deleted.
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="DeleteStudy" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
