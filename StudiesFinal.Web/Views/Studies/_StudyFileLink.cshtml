@*
    Un archivo del estudio: nombre y formas de abrirlo. Por seguridad no se muestra la ruta
    del servidor; el archivo se abre a través de la web (Studies/OpenFile).
      - Open beside: ventana aparte en la mitad derecha de la pantalla (para llenar el informe a la vez)
      - New tab:     pestaña nueva con el visor del navegador
      - PDF reader:  descarga el archivo; al abrirlo se usa el lector de PDF instalado
*@
@model StudyFileLink

@{
    var fileName = System.IO.Path.GetFileName(Model.Path.TrimEnd('\\', '/'));
    var openUrl = Url.Action("OpenFile", "Studies", new { id = Model.StudyId, slot = Model.Slot });
    var downloadUrl = Url.Action("OpenFile", "Studies", new { id = Model.StudyId, slot = Model.Slot, download = true });
}

<div class="sf-file-item">
    <a class="sf-file" href="@openUrl" target="_blank" rel="noopener" data-open-beside title="Open beside the form">
        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
        <span class="small fw-semibold text-break">@fileName</span>
    </a>
    <div class="sf-file-actions">
        <a class="btn btn-sm btn-primary" href="@openUrl" target="_blank" rel="noopener" data-open-beside>
            <i class="bi bi-layout-split me-1" aria-hidden="true"></i>Open beside
        </a>
        <a class="btn btn-sm btn-outline-secondary" href="@openUrl" target="_blank" rel="noopener" title="Open in a new tab">
            <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>New tab
        </a>
        <a class="btn btn-sm btn-outline-secondary" href="@downloadUrl" title="Download and open with the PDF reader installed on this computer">
            <i class="bi bi-filetype-pdf me-1" aria-hidden="true"></i>PDF reader
        </a>
    </div>
</div>
