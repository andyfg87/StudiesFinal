@model StudyTemplateDisplayVM
@inject StudiesFinal.Web.Services.IRichTextSanitizer Sanitizer
@{
    ViewData["Title"] = Model.StudyTitle;
    var canManage = StudiesFinal.Web.Services.StudyWorkflow.CanManageTemplates(User);
}

<nav class="crumbs" aria-label="Migas">
    <a asp-action="Index">Plantillas</a> / <span>@Model.StudyTitle</span>
</nav>

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
        <div>
            <h2>@Model.StudyTitle</h2>
            <div class="ls-sub">Nombre del estudio: @Model.GenericName</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Studies" asp-action="Create" asp-route-templateId="@Model.Id" class="btn btn-primary">
            <i class="bi bi-file-earmark-plus me-1" aria-hidden="true"></i>Nuevo estudio con esta plantilla
        </a>
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-key="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar
            </a>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="sf-report">@Sanitizer.Render(Model.StudyInfo)</div>
    </div>
</div>
