@model StudyTemplateInputVM
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label asp-for="StudyTitle" class="form-label"></label>
                    <input asp-for="StudyTitle" class="form-control" autofocus />
                    <span asp-validation-for="StudyTitle" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="GenericName" class="form-label"></label>
                    <input asp-for="GenericName" class="form-control" />
                    <span asp-validation-for="GenericName" class="text-danger small"></span>
                </div>
            </div>

            <label class="form-label">Content</label>
            <input type="hidden" asp-for="StudyInfo" />
            <partial name="_RichEditor" model="@("StudyInfo")" />
        </div>
    </div>

    <div class="sf-sticky-actions d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1" aria-hidden="true"></i>Save</button>
        <a href="@Url.BackToList()" class="btn btn-secondary">Cancel</a>
    </div>
</form>
