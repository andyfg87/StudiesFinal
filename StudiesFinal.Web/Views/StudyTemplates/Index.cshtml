@using StudiesFinal.Web.Paginations
@model PaginatedList<StudyTemplateDisplayVM>

@{
    ViewData["Title"] = "Plantillas";
    var canManage = StudiesFinal.Web.Services.StudyWorkflow.CanManageTemplates(User);
}

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
        <div>
            <h2>Plantillas de informe</h2>
            <div class="ls-sub">
                @Model.TotalCount @(Model.TotalCount == 1 ? "plantilla" : "plantillas")
                @if (!canManage)
                {
                    <span>· solo lectura</span>
                }
            </div>
        </div>
    </div>

    @if (canManage)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nueva plantilla
            </a>
        </div>
    }
</div>

<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle ls-table mb-0">
            <thead>
                <tr>
                    <th>Plantilla</th>
                    <th>Nombre del estudio</th>
                    <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center py-5 text-muted">No hay plantillas.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Plantilla">
                            <div class="ls-device">
                                <span class="ls-tile" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                                <a class="n text-reset text-decoration-none fw-semibold" asp-action="Details" asp-route-key="@item.Id">@item.StudyTitle</a>
                            </div>
                        </td>
                        <td data-label="Nombre del estudio">@item.GenericName</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Studies" asp-action="Create" asp-route-templateId="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   title="Nuevo estudio con esta plantilla" aria-label="Nuevo estudio con @item.StudyTitle">
                                    <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                                </a>
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-key="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar" aria-label="Editar @item.StudyTitle">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"
                                            title="Eliminar" aria-label="Eliminar @item.StudyTitle">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                }
                                <a asp-action="Details" asp-route-key="@item.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                                    Ver <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </div>

                            @if (canManage)
                            {
                                <div class="modal fade text-start" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title text-danger">Eliminar plantilla</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                            </div>
                                            <div class="modal-body">
                                                ¿Seguro que deseas eliminar <strong>@item.StudyTitle</strong>?
                                                <br />Los estudios ya creados con ella no cambian.
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="DeleteTemplate" method="post">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
