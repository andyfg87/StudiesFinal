@using StudiesFinal.Web.Paginations
@model PaginatedList<StudyTemplateDisplayVM>

@{
    // Filtros del listado: viajan a Create/Edit/Details para que Back vuelva aquí igual
    var listRoute = ViewBag.RouteValues as RouteValueDictionary;

    ViewData["Title"] = "Templates";
    var canManage = StudiesFinal.Web.Services.StudyWorkflow.CanManageTemplates(User);
}

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
        <div>
            <h2>Report templates</h2>
            <div class="ls-sub">
                @Model.TotalCount @(Model.TotalCount == 1 ? "template" : "templates")
                @if (!canManage)
                {
                    <span>· read only</span>
                }
            </div>
        </div>
    </div>

    @if (canManage)
    {
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.ListChild("Create", null, listRoute)" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New template
            </a>
        </div>
    }
</div>

<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle ls-table mb-0">
            <thead>
                <tr>
                    <th>Template</th>
                    <th>Study name</th>
                    <th class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center py-5 text-muted">There are no templates.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Template">
                            <div class="ls-device">
                                <span class="ls-tile" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                                <a class="n text-reset text-decoration-none fw-semibold" href="@Url.ListChild("Details", new { key = item.Id }, listRoute)">@item.StudyTitle</a>
                            </div>
                        </td>
                        <td data-label="Study name">@item.GenericName</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Studies" asp-action="Create" asp-route-templateId="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   title="New study with this template" aria-label="New study with @item.StudyTitle">
                                    <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                                </a>
                                @if (canManage)
                                {
                                    <a href="@Url.ListChild("Edit", new { key = item.Id }, listRoute)" class="btn btn-sm btn-outline-secondary" title="Edit" aria-label="Edit @item.StudyTitle">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"
                                            title="Delete" aria-label="Delete @item.StudyTitle">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                }
                                <a href="@Url.ListChild("Details", new { key = item.Id }, listRoute)" class="btn btn-sm btn-outline-primary text-nowrap">
                                    View <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </div>

                            @if (canManage)
                            {
                                <div class="modal fade text-start" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title text-danger">Delete template</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete <strong>@item.StudyTitle</strong>?
                                                <br />Studies already created with it do not change.
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="DeleteTemplate" method="post">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
