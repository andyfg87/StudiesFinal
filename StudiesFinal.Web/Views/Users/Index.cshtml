@using StudiesFinal.Web.Paginations
@model PaginatedList<UserDisplayVM>

@{
    ViewData["Title"] = "Users";
    var fSearch = Context.Request.Query["search"].ToString();
    var me = User.UserId();
}

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
        <div>
            <h2>Users</h2>
            <div class="ls-sub">Administrators, doctors and technicians with access to the application</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>New user
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-4">
                <label for="search" class="form-label">Search</label>
                <input type="search" class="form-control" id="search" name="search" placeholder="Username or name…" value="@fSearch" />
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle ls-table mb-0">
            <thead>
                <tr>
                    <th>@Html.SortHeader("Name", "name")</th>
                    <th>@Html.SortHeader("Username", "user")</th>
                    <th>@Html.SortHeader("Role", "role")</th>
                    <th>Status</th>
                    <th class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Name" class="fw-semibold">@item.FullName @(item.Id == me ? "(you)" : "")</td>
                        <td data-label="Username">@item.UserName</td>
                        <td data-label="Role">
                            <span class="ls-pill @(item.Role == UserRole.Admin ? "danger" : item.Role == UserRole.Doctor ? "primary" : "info")">@item.RoleLabel</span>
                        </td>
                        <td data-label="Status">
                            @if (item.IsActive)
                            {
                                <span class="ls-pill success">Active</span>
                            }
                            else
                            {
                                <span class="ls-pill">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-key="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit" aria-label="Edit @item.FullName">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                @if (item.Id != me)
                                {
                                    <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete user @item.UserName?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete @item.FullName">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
