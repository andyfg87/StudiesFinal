@using StudiesFinal.Web.Paginations
@model PaginatedList<PatientDisplayVM>

@{
    ViewData["Title"] = "Pacientes";
    var fSearch = Context.Request.Query["search"].ToString();
    var hasFilters = !string.IsNullOrEmpty(fSearch);
}

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-people"></i></span>
        <div>
            <h2>Pacientes</h2>
            <div class="ls-sub">@Model.TotalCount @(Model.TotalCount == 1 ? "paciente" : "pacientes")</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Nuevo paciente
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label for="search" class="form-label">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="search" class="form-control" id="search" name="search"
                           placeholder="Nombre o nº de paciente…" value="@fSearch" autofocus />
                </div>
            </div>

            <div class="col-12 col-md-4 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filtrar
                </button>
                @if (hasFilters)
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary" title="Limpiar filtros" aria-label="Limpiar filtros">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle ls-table mb-0">
            <thead>
                <tr>
                    <th>@Html.SortHeader("Nº", "id")</th>
                    <th>@Html.SortHeader("Nombre", "name")</th>
                    <th>@Html.SortHeader("Nacimiento", "dob")</th>
                    <th class="text-center">@Html.SortHeader("Estudios", "studies")</th>
                    <th>@Html.SortHeader("Último estudio", "last")</th>
                    <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50" aria-hidden="true"></i>
                            <div class="fw-semibold">No hay pacientes que coincidan</div>
                            @if (hasFilters)
                            {
                                <a href="@Url.Action("Index")" class="small">Quitar filtros</a>
                            }
                        </td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Nº" class="text-muted">@item.Id</td>
                        <td data-label="Nombre">
                            <div class="ls-device">
                                <span class="ls-tile" aria-hidden="true"><i class="bi bi-person"></i></span>
                                <a class="n text-reset text-decoration-none fw-semibold" asp-action="Details" asp-route-key="@item.Id">@(item.Name ?? "(sin nombre)")</a>
                            </div>
                        </td>
                        <td data-label="Nacimiento" class="text-nowrap">
                            @item.DateOfBirth?.ToString("MM/dd/yyyy")
                            @if (item.Age.HasValue)
                            {
                                <span class="text-muted small">· @item.Age años</span>
                            }
                        </td>
                        <td data-label="Estudios" class="text-center">@item.StudyCount</td>
                        <td data-label="Último estudio">@item.LastStudyDate?.ToString("MM/dd/yyyy")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Studies" asp-action="Create" asp-route-patientId="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   title="Nuevo estudio" aria-label="Nuevo estudio para @item.Name">
                                    <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Edit" asp-route-key="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   title="Editar" aria-label="Editar @item.Name">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Details" asp-route-key="@item.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                                    Ver <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
