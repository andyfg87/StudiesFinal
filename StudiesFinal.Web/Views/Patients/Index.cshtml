@using StudiesFinal.Web.Paginations
@model PaginatedList<PatientDisplayVM>

@{
    ViewData["Title"] = "Patients";
    var fSearch = Context.Request.Query["search"].ToString();
    var fDob = Context.Request.Query["dob"].ToString();
    var hasFilters = !string.IsNullOrEmpty(fSearch) || !string.IsNullOrEmpty(fDob);
}

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-people"></i></span>
        <div>
            <h2>Patients</h2>
            <div class="ls-sub">@Model.TotalCount @(Model.TotalCount == 1 ? "patient" : "patients")</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>New patient
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label for="search" class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="search" class="form-control" id="search" name="search"
                           placeholder="Name or patient #…" value="@fSearch" autofocus />
                </div>
            </div>

            <div class="col-12 col-md-4 col-lg-2">
                <label for="dob" class="form-label">Date of birth</label>
                <input type="date" class="form-control" id="dob" name="dob" value="@fDob" />
            </div>

            <div class="col-12 col-md-4 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter
                </button>
                @if (hasFilters)
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary" title="Clear filters" aria-label="Clear filters">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle ls-table mb-0">
            <thead>
                <tr>
                    <th>@Html.SortHeader("#", "id")</th>
                    <th>@Html.SortHeader("Last Name", "lastName")</th>
                    <th>@Html.SortHeader("Name", "name")</th>
                    <th>@Html.SortHeader("Date of birth", "dob")</th>
                    <th class="text-center">@Html.SortHeader("Studies", "studies")</th>
                    <th>@Html.SortHeader("Last study", "last")</th>
                    <th class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50" aria-hidden="true"></i>
                            <div class="fw-semibold">No patients match the filters</div>
                            @if (hasFilters)
                            {
                                <a href="@Url.Action("Index")" class="small">Clear filters</a>
                            }
                        </td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="#" class="text-muted">@item.Id</td>
                        <td data-label="LastName">
                            <div class="ls-device">
                                <span class="ls-tile" aria-hidden="true"><i class="bi bi-person"></i></span>
                                <a class="n text-reset text-decoration-none fw-semibold" asp-action="Details" asp-route-key="@item.Id">@(item.LastName ?? "(no name)")</a>
                            </div>
                        </td>
                        <td data-label="Name">
                            <div class="ls-device">
                                <span class="ls-tile" aria-hidden="true"><i class="bi bi-person"></i></span>
                                <a class="n text-reset text-decoration-none fw-semibold" asp-action="Details" asp-route-key="@item.Id">@(item.Name ?? "(no last name)")</a>
                            </div>
                        </td>
                        <td data-label="Date of birth" class="text-nowrap">
                            @item.DateOfBirth?.ToString("MM/dd/yyyy")
                            @if (item.Age.HasValue)
                            {
                                <span class="text-muted small">· @item.Age years</span>
                            }
                        </td>
                        <td data-label="Studies" class="text-center">@item.StudyCount</td>
                        <td data-label="Last study">@item.LastStudyDate?.ToString("MM/dd/yyyy")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Studies" asp-action="Create" asp-route-patientId="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   title="New study" aria-label="New study for @item.Name">
                                    <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Edit" asp-route-key="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   title="Edit" aria-label="Edit @item.Name">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Details" asp-route-key="@item.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                                    View <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
