@model PatientDisplayVM
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.FullName) ? $"Patient {Model.Id}" : Model.FullName;
    var studies = ViewBag.Studies as List<StudyDisplayVM> ?? new();
    var isAdmin = User.IsInRole(Roles.Admin);
}

<nav class="crumbs" aria-label="Breadcrumb">
    <h2><a href="@Url.BackToList()">Patients</a> / <span>@Model.FullName</span></h2>
</nav>

<div class="ls-head">
    <div class="d-flex align-items-center gap-3">
        <span class="ls-tile lg" aria-hidden="true"><i class="bi bi-person"></i></span>
        <div>
            <h2>@(string.IsNullOrEmpty(Model.FullName) ? "(no name)" : Model.FullName)</h2>
            <div class="ls-sub">
                Patient # @Model.Id
                @if (Model.DateOfBirth.HasValue)
                {
                    <span> · Date of birth @Model.DateOfBirth.Value.ToString("MM/dd/yyyy") (@Model.Age years)</span>
                }
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @Html.BackButton()
        <a asp-controller="Studies" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-primary">
            <i class="bi bi-file-earmark-plus me-1" aria-hidden="true"></i>New study
        </a>
        <a href="@Url.ListChild("Edit", new { key = Model.Id })" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
        </a>
        @if (isAdmin && !studies.Any())
        {
            <form asp-action="DeletePatient" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this patient?');">
                <button type="submit" class="btn btn-outline-danger" title="Delete" aria-label="Delete patient">
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                </button>
            </form>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body pb-0">
        <h3 class="h6 mb-0">Studies (@studies.Count)</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle ls-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Study</th>
                    <th>Status</th>
                    <th>Signed</th>
                    <th class="text-center">Files</th>
                    <th class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!studies.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">This patient has no studies.</td></tr>
                }
                @foreach (var s in studies)
                {
                    <tr>
                        <td data-label="#" class="text-muted">@s.Id</td>
                        <td data-label="Date" class="text-nowrap">@s.StudyDate.ToString("MM/dd/yyyy")</td>
                        <td data-label="Study">@s.StudyName</td>
                        <td data-label="Status">@Html.StatusPill(s.Status)</td>
                        <td data-label="Signed" class="small">@s.SignedAt?.ToString("MM/dd/yyyy") <span class="text-muted">@s.SignedByName</span></td>
                        <td data-label="Files" class="text-center">
                            @foreach (var link in s.Links)
                            {
                                <a asp-controller="Studies" asp-action="OpenFile" asp-route-id="@s.Id" asp-route-slot="@link.Slot" target="_blank" rel="noopener"
                                   class="btn btn-sm btn-link px-1" title="@System.IO.Path.GetFileName(link.Path)" aria-label="Open file @link.Slot">
                                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                </a>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="Studies" asp-action="Details" asp-route-key="@s.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                                View <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
