@model PatientInputVM

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent border-bottom">
                <h3 class="mb-0 h5">@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-returnToStudy="@Context.Request.Query["returnToStudy"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="IsEdit" />

                    <div class="mb-3">
                        <label asp-for="Id" class="form-label"></label>
                        @if (Model.IsEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                            <input class="form-control" value="@Model.Id" disabled />
                        }
                        else
                        {
                            <input asp-for="Id" class="form-control" />
                            <div class="form-text">The next available number is suggested.</div>
                        }
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autofocus />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        @if (Model.IsEdit)
                        {
                            <a asp-action="Details" asp-route-key="@Model.Id" class="btn btn-secondary">Cancel</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
